@model InternProjects.Models.ViewModels.ManualHoursViewModel
@{
    ViewData["Title"] = "Ръчно добавяне на часове";
}

<nav class="mb-3"><a asp-controller="Dashboard" asp-action="Admin">← Към таблото</a></nav>

<div class="row justify-content-center">
    <div class="col-lg-6">
        <h3 class="mb-1">Ръчно добавяне на часове</h3>
        <p class="text-muted mb-4">За дейности извън задачите: обучение в сервиза, диагностика, наблюдение на ремонт... (т. 21)</p>

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-warning">@TempData["Error"]</div>
        }

        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

            <div class="card">
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="InternId" class="form-label">Стажант *</label>
                        <select asp-for="InternId" asp-items="Model.Interns" class="form-select">
                            <option value="">— избери —</option>
                        </select>
                        <span asp-validation-for="InternId" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Date" class="form-label">Дата *</label>
                            <input asp-for="Date" class="form-control" />
                            <span asp-validation-for="Date" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Hours" class="form-label">Часове *</label>
                            <input asp-for="Hours" class="form-control" type="number" step="0.5" min="0.5" max="12" />
                            <span asp-validation-for="Hours" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label">Описание на дейността *</label>
                        <textarea asp-for="Description" class="form-control" rows="3"
                                  placeholder="Напр.: Практическо участие при диагностика и профилактика на лаптопи."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="mb-0">
                        <label asp-for="Note" class="form-label">Бележка</label>
                        <input asp-for="Note" class="form-control" placeholder="Незадължителна" />
                    </div>
                </div>
            </div>

            <div class="mt-3">
                <button type="submit" class="btn btn-primary">Добави часовете</button>
                <a asp-controller="Dashboard" asp-action="Admin" class="btn btn-outline-secondary">Отказ</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}