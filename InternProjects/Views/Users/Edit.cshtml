@model InternProjects.Models.ViewModels.UserEditViewModel
@{
    ViewData["Title"] = "Редакция на потребител";
}

<nav class="mb-3"><a asp-action="Index">← Потребители</a></nav>

<div class="row justify-content-center">
    <div class="col-lg-6">
        <h3 class="mb-4">Редакция: @Model.FirstName @Model.LastName</h3>

        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
            <input type="hidden" asp-for="Id" />

            <div class="card">
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="FirstName" class="form-label">Име *</label>
                            <input asp-for="FirstName" class="form-control" />
                            <span asp-validation-for="FirstName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="LastName" class="form-label">Фамилия *</label>
                            <input asp-for="LastName" class="form-control" />
                            <span asp-validation-for="LastName" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">Имейл *</label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PhoneNumber" class="form-label">Телефон</label>
                        <input asp-for="PhoneNumber" class="form-control" />
                    </div>

                    <hr />

                    <div class="mb-0">
                        <label asp-for="NewPassword" class="form-label">Нова парола</label>
                        <input asp-for="NewPassword" class="form-control" />
                        <div class="form-text">Остави празно, ако не искаш да я променяш</div>
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                    </div>
                    @if (Model.IsIntern)
                    {
                        <hr />

                        <div class="card mt-3">
                            <div class="card-body">

                                <h6 class="fw-bold mb-3">Данни за стажа</h6>

                                <div class="row">

                                    <div class="col-md-6 mb-3">
                                        <label asp-for="University" class="form-label">
                                            Университет/Училище
                                        </label>
                                        <input asp-for="University" class="form-control" />
                                    </div>


                                    <div class="col-md-6 mb-3">
                                        <label asp-for="Specialty" class="form-label">
                                            Специалност
                                        </label>
                                        <input asp-for="Specialty" class="form-control" />
                                    </div>

                                </div>


                                <div class="row">

                                    <div class="col-md-4 mb-3">
                                        <label asp-for="StartDate" class="form-label">
                                            Начало
                                        </label>
                                        <input asp-for="StartDate"
                                               type="date"
                                               class="form-control" />
                                    </div>


                                    <div class="col-md-4 mb-3">
                                        <label asp-for="EndDate" class="form-label">
                                            Край
                                        </label>
                                        <input asp-for="EndDate"
                                               type="date"
                                               class="form-control" />
                                    </div>


                                    <div class="col-md-4 mb-3">
                                        <label asp-for="TotalHours" class="form-label">
                                            Изискуеми часове
                                        </label>
                                        <input asp-for="TotalHours"
                                               type="number"
                                               class="form-control" />
                                    </div>

                                </div>


                                <div class="mb-0">
                                    <label asp-for="Notes" class="form-label">
                                        Бележки
                                    </label>

                                    <textarea asp-for="Notes"
                                              class="form-control"
                                              rows="2"></textarea>
                                </div>

                            </div>
                        </div>
                    }

                </div>
            </div>

            <div class="mt-3">
                <button type="submit" class="btn btn-primary">Запази</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Отказ</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}