@model List<InternProjects.Models.ViewModels.UserListItemViewModel>
@{
    ViewData["Title"] = "Потребители";
}

<div class="d-flex justify-content-between align-items-center mb-1">
    <h2 class="mb-0">Управление на потребители</h2>
    <a asp-action="Create" class="btn btn-primary">+ Нов потребител</a>
</div>
<p class="text-muted mb-3">Акаунти, роли и достъп</p>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-warning">@TempData["Error"]</div>
}

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Име</th>
                    <th>Имейл</th>
                    <th>Роля</th>
                    <th>Статус</th>
                    <th>Последен вход</th>
                    <th class="text-end">Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr class="@(u.Status != "Активен" ? "table-secondary" : "")">
                        <td>
                            @if (u.InternId != null)
                            {
                                <a asp-controller="InternProfile" asp-action="Details"
                                   asp-route-id="@u.InternId">@u.FullName</a>
                            }
                            else
                            {
                                @u.FullName
                            }
                        </td>
                        <td class="text-muted">@u.Email</td>
                        <td>
                            <span class="badge @(u.Role == "Admin" ? "bg-dark" : "bg-primary")">@u.Role</span>
                        </td>
                        <td>
                            <span class="badge @(u.Status == "Активен" ? "bg-success" : "bg-secondary")">@u.Status</span>
                        </td>
                        <td class="text-muted small">@(u.LastLogin?.ToString("dd.MM.yyyy HH:mm") ?? "никога")</td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-sm btn-outline-primary">Редакция</a>
                            <form asp-action="ToggleStatus" asp-route-id="@u.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('@(u.Status == "Активен" ? "Деактивирай" : "Активираш") @u.FullName?');">
                                <button type="submit" class="btn btn-sm @(u.Status == "Активен" ? "btn-outline-danger" : "btn-outline-success")">
                                    @(u.Status == "Активен" ? "Деактивирай" : "Активирай")
                                </button>
                            </form>
                            <form asp-action="Delete"
                                  asp-route-id="@u.Id"
                                  method="post"
                                  class="d-inline"
                                  onsubmit="return confirm('Сигурни ли сте, че искате да изтриете @u.FullName?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-danger">
                                    Изтрий
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div></div>