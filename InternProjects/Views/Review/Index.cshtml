@model List<InternProjects.Models.ViewModels.ReviewListItemViewModel>
@{
    ViewData["Title"] = "Задачи за проверка";
}

<h2 class="mb-1">Задачи за проверка</h2>
<p class="text-muted mb-4">Предадени задачи, чакащи одобрение</p>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Задача</th>
                    <th>Стажант(и)</th>
                    <th>Часове</th>
                    <th>Предадена на</th>
                    <th class="text-end">Действие</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @item.TaskTitle
                            @if (item.IsTeamTask)
                            {
                                <span class="badge bg-dark ms-1">Екипна</span>
                            }
                            <div class="small text-muted">@item.CategoryName</div>
                        </td>
                        <td>
                            @string.Join(", ", item.MemberNames)
                            @if (item.MemberNames.Count > 1)
                            {
                                <div class="small text-muted">@item.MemberNames.Count стажанти</div>
                            }
                        </td>
                        <td>
                            @item.AssignedHours ч.
                            @if (item.MemberNames.Count > 1)
                            {
                                <div class="small text-muted">на всеки</div>
                            }
                        </td>
                        <td>@item.SubmitDate?.ToString("dd.MM.yyyy HH:mm")</td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@item.AssignmentId" class="btn btn-sm btn-primary">
                                Провери
                            </a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-5">
                            Няма задачи за проверка.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>