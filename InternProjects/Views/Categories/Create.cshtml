@model InternProjects.Models.Category
@{
    ViewData["Title"] = "Нова категория";
}

<nav class="mb-3"><a asp-action="Index">← Категории</a></nav>

<div class="row justify-content-center">
    <div class="col-lg-6">
        <h3 class="mb-4">Нова категория</h3>

        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

            <div class="card">
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label">Име *</label>
                        <input asp-for="Name" class="form-control" placeholder="Напр.: Киберсигурност" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="mb-0">
                        <label asp-for="Description" class="form-label">Описание</label>
                        <textarea asp-for="Description" class="form-control" rows="3"
                                  placeholder="Какви задачи влизат тук"></textarea>
                    </div>
                </div>
            </div>

            <div class="mt-3">
                <button type="submit" class="btn btn-primary">Създай</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Отказ</a>
            </div>
        </form>
    </div>
</div>