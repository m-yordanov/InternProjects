@model InternProjects.Models.Category
@{
    ViewData["Title"] = "Редакция на категория";
}


<nav class="mb-3"><a asp-action="Index">← Категории</a></nav>

<div class="row justify-content-center">
    <div class="col-lg-6">
        <h3 class="mb-4">Редакция: @Model.Name</h3>

        @if (ViewData["Error"] != null)
        {
            <div class="alert alert-danger">
                @ViewData["Error"]
            </div>
        }

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">
                @TempData["Success"]
            </div>
        }


        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

            <input type="hidden" asp-for="Id" />

            <div class="card">
                <div class="card-body">

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label">Име *</label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-0">
                        <label asp-for="Description" class="form-label">Описание</label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    </div>

                </div>
            </div>

            <div class="mt-3">
                <button type="submit" class="btn btn-primary">
                    Запази
                </button>

                <a asp-action="Index" class="btn btn-outline-secondary">
                    Отказ
                </a>
            </div>
        </form>


        <form asp-action="Delete" method="post"
              class="mt-3"
              onsubmit="return confirm('Сигурни ли сте, че искате да изтриете тази категория?');">

            <input type="hidden" name="id" value="@Model.Id" />

            <button type="submit" class="btn btn-danger">
                Изтрий категория
            </button>

        </form>
    </div>
</div>