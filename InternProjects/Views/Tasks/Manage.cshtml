@model List<InternProjects.Models.TaskItem>
@{
    ViewData["Title"] = "Управление на задачи";
    var current = ViewBag.CurrentStatus as string;
    var statuses = new[] { "Чернова", "Свободна", "В процес", "Предадена за проверка",
                           "Върната за корекция", "Приета", "Отхвърлена", "Архивирана" };
}

<div class="d-flex justify-content-between align-items-center mb-1">
    <h2 class="mb-0">Управление на задачи</h2>
    <a asp-action="Create" class="btn btn-primary">+ Нова задача</a>
</div>
<p class="text-muted mb-3">Всички задачи, включително чернови и архив</p>

<div class="mb-3">
    <a asp-action="Manage" class="btn btn-sm @(current == null ? "btn-dark" : "btn-outline-dark")">Всички</a>
    @foreach (var st in statuses)
    {
        <a asp-action="Manage" asp-route-status="@st"
           class="btn btn-sm @(current == st ? "btn-dark" : "btn-outline-dark")">@st</a>
    }
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Задача</th>
                    <th>Категория</th>
                    <th>Часове</th>
                    <th>Статус</th>
                    <th>Създадена</th>
                    <th class="text-end">Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model)
                {
                    <tr>
                        <td>@t.Title</td>
                        <td class="text-muted">@t.Category?.Name</td>
                        <td>@t.AssignedHours ч.</td>
                        <td>
                            <span class="badge @(t.Status == "Свободна" ? "bg-success" :
                                                                               t.Status == "Чернова" ? "bg-secondary" :
                                                                               t.Status == "Архивирана" ? "bg-dark" :
                                                                               t.Status == "Приета" ? "bg-success" :
                                                                               "bg-primary")">@t.Status</span>
                        </td>
                        <td class="text-muted small">@t.CreationDate.ToString("dd.MM.yyyy")</td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@t.Id" class="btn btn-sm btn-outline-primary">Редакция</a>

                            @if (t.Status == "Чернова")
                            {
                                <form asp-action="Publish" asp-route-id="@t.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-success">Публикувай</button>
                                </form>
                            }
                            @if (t.Status != "Архивирана")
                            {
                                <form asp-action="Archive" asp-route-id="@t.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Архивираш „@t.Title\" ?');">
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">Архивирай</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-5">Няма задачи по този филтър.</td></tr>
                }
            </tbody>
        </table>
    </div></div>