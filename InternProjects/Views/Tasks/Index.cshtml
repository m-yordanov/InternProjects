@model InternProjects.Models.ViewModels.TaskListViewModel
@{
    ViewData["Title"] = "Свободни задачи";
}

<h2 class="mb-1">Свободни задачи</h2>
<p class="text-muted mb-4">Избери задача според интересите и уменията си</p>

@if (TempData["Error"] != null)
{
    <div class="alert alert-warning">@TempData["Error"]</div>
}

<form method="get" class="card bg-light mb-4">
    <div class="card-body row g-2 align-items-end">
        <div class="col-md-4">
            <label class="form-label small text-muted">Търсене</label>
            <input type="text" name="search" value="@Model.Search" class="form-control"
                   placeholder="Ключова дума..." />
        </div>
        <div class="col-md-3">
            <label class="form-label small text-muted">Категория</label>
            <select name="categoryId" class="form-select">
                <option value="">Всички</option>
                @foreach (var c in Model.Categories)
                {
                    <option value="@c.Id" selected="@(Model.CategoryId == c.Id)">@c.Name</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label small text-muted">Сложност</label>
            <select name="difficulty" class="form-select">
                <option value="">Всички</option>
                @foreach (var d in new[] { "Лесна", "Средна", "Трудна", "Екипна" })
                {
                    <option value="@d" selected="@(Model.Difficulty == d)">@d</option>
                }
            </select>
        </div>
        <div class="col-md-2 d-grid gap-1">
            <button type="submit" class="btn btn-primary">Филтрирай</button>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Изчисти</a>
        </div>
    </div>
</form>

<div class="row g-3">
    @foreach (var t in Model.Tasks)
    {
        <div class="col-md-6 col-lg-4">
            <div class="card h-100">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <span class="badge bg-secondary">@t.Category?.Name</span>
                        <span class="badge @(t.Difficulty == "Лесна" ? "bg-success" :
                                                                           t.Difficulty == "Средна" ? "bg-primary" :
                                                                           t.Difficulty == "Трудна" ? "bg-danger" : "bg-dark")">
                            @t.Difficulty
                        </span>
                    </div>
                    <h5 class="card-title">@t.Title</h5>
                    <p class="card-text text-muted small flex-grow-1">@t.ShortDescription</p>
                    <div class="d-flex justify-content-between align-items-center small text-muted mb-3">
                        <span>⏱ @t.AssignedHours ч.</span>
                        @if (t.Deadline != null)
                        {
                            <span>Срок: @t.Deadline?.ToString("dd.MM.yyyy")</span>
                        }
                    </div>
                    <a asp-action="Details" asp-route-id="@t.Id" class="btn btn-outline-primary w-100">
                        Виж детайли
                    </a>
                </div>
            </div>
        </div>
    }
    @if (!Model.Tasks.Any())
    {
        <div class="col-12">
            <div class="alert alert-secondary text-center py-5">
                Няма свободни задачи по тези критерии.
            </div>
        </div>
    }
</div>